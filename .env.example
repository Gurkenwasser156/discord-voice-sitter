DISCORD_TOKEN=dein-bot-token
GUILD_ID=server-id
CHANNEL_ID=voice-channel-id

# AzuraCast Public Page – Stream-URL und Now Playing kommen automatisch aus der API
RADIO_URL=https://radio.j-indies.net/public/j-indies

# Optional
# STREAM_URL=        # Stream-URL fest vorgeben statt aus der API
# VOLUME=30%         # Lautstärke, Standard 30% (auch 0.3 möglich, 100% = original)
# FFMPEG_PATH=       # eigenes ffmpeg statt ffmpeg-static / System-ffmpeg
# DATA_DIR=./data    # wo Favoriten gespeichert werden (im Docker-Image: /app/data)

# Optional: private YouTube-Playlists für /fav (/youtube verbinden)
# Einrichtung in der Google Cloud Console (console.cloud.google.com), einmalig:
#  1. Projekt anlegen, "YouTube Data API v3" aktivieren
#  2. OAuth-Zustimmungsbildschirm: Typ "Extern", Scope .../auth/youtube,
#     danach Veröffentlichungsstatus auf "In Produktion" setzen
#     (im Testmodus laufen Logins nach 7 Tagen ab und nur eingetragene Testnutzer dürfen rein)
#  3. Anmeldedaten -> OAuth-Client-ID -> Typ "Fernseher und Geräte mit begrenzter Eingabe"
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
